FROM debian:trixie-slim

ARG USERNAME=app
ARG TARGETARCH
ARG GIT_VERSION=v2.55.0
ARG JJ_VERSION=v0.45.1

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/home/${USERNAME}/.rustup
ENV CARGO_HOME=/home/${USERNAME}/.cargo
ENV PATH="/home/${USERNAME}/.cargo/bin:/usr/local/nvim/bin:${PATH}"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    tini \
    ripgrep \
    zlib1g-dev \
    libcurl4-openssl-dev \
    curl \
    ca-certificates \
    libssl-dev \
    libexpat1-dev \
    gettext \
    sudo \
    zsh \
    openssh-server \
    gh \
    jq

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    -o /usr/share/keyrings/nodesource.asc \
    && printf 'deb [signed-by=/usr/share/keyrings/nodesource.asc] https://deb.nodesource.com/node_26.x nodistro main\n' \
        >/etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs

RUN --mount=type=cache,target=/root/.npm,sharing=shared \
    --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=shared \
    npm install -g --no-audit --no-fund npm@latest pnpm@latest

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

RUN curl -fsSL -o /tmp/git.tar.gz "https://github.com/git/git/archive/refs/tags/${GIT_VERSION}.tar.gz" \
    && tar -xzf /tmp/git.tar.gz -C /tmp \
    && cd "/tmp/git-${GIT_VERSION#v}" \
    && mkdir -p t/helper/.depend \
    && make -j"$(nproc)" prefix=/usr/local NO_TCLTK=1 NO_GITWEB=1 \
    && make prefix=/usr/local install \
    && cd / && rm -rf /tmp/git-* /tmp/git.tar.gz

RUN JJ_ARCH=$([ "$TARGETARCH" = "amd64" ] && echo "x86_64" || echo "aarch64") \
    && curl -fsSL -o /tmp/jj.tar.gz "https://github.com/jj-vcs/jj/releases/download/${JJ_VERSION}/jj-${JJ_VERSION}-${JJ_ARCH}-unknown-linux-musl.tar.gz" \
    && tar -C /usr/local/bin --strip-components=1 -xzf /tmp/jj.tar.gz \
    && rm /tmp/jj.tar.gz

RUN NVIM_ARCH=$([ "$TARGETARCH" = "amd64" ] && echo "x86_64" || echo "arm64") \
    && curl -fsSL -o /tmp/nvim.tar.gz "https://github.com/neovim/neovim/releases/download/nightly/nvim-linux-${NVIM_ARCH}.tar.gz" \
    && tar -C /usr/local -xzf /tmp/nvim.tar.gz \
    && ln -s /usr/local/nvim-linux-${NVIM_ARCH} /usr/local/nvim \
    && rm /tmp/nvim.tar.gz

RUN mkdir -p /etc/ssh/sshd_config.d \
    && printf "%s\n" \
        "Port 2222" \
        "PasswordAuthentication no" \
        "KbdInteractiveAuthentication no" \
        "PermitRootLogin no" \
        "AllowUsers ${USERNAME}" \
        "HostKey /home/${USERNAME}/.ssh/ssh_host_rsa_key" \
        "HostKey /home/${USERNAME}/.ssh/ssh_host_ecdsa_key" \
        "HostKey /home/${USERNAME}/.ssh/ssh_host_ed25519_key" \
        "PidFile /home/${USERNAME}/.sshd/sshd.pid" \
        >/etc/ssh/sshd_config.d/99-workspace.conf

RUN useradd -ms "$(command -v zsh)" ${USERNAME} \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >/etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME \
    && mkdir -p /home/${USERNAME}/workspaces /home/${USERNAME}/.sshd /home/${USERNAME}/.ssh \
    && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME} \
    && chmod 700 /home/${USERNAME}/.ssh

COPY --chown=${USERNAME}:${USERNAME} workspaces-entrypoint.sh /usr/local/bin/workspaces-entrypoint.sh
RUN chmod 755 /usr/local/bin/workspaces-entrypoint.sh

USER ${USERNAME}
WORKDIR /home/${USERNAME}/workspaces
EXPOSE 2222

ENTRYPOINT ["tini", "--", "/usr/local/bin/workspaces-entrypoint.sh"]
